{
    // F5 runs the selected configuration. Requires the C# extension (ms-dotnettools.csharp).
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Client (net10.0)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build client",
            "program": "${workspaceFolder}/LyricsScraperNET.Client/bin/Debug/net10.0/LyricsScraperNET.Client.dll",
            "args": [],
            "cwd": "${workspaceFolder}/LyricsScraperNET.Client",
            // The client waits for a key at the end: the integrated terminal accepts input, the debug console does not.
            "console": "integratedTerminal",
            "stopAtEntry": false
        },
        {
            "name": "Attach to process",
            "type": "coreclr",
            "request": "attach"
        }
    ]
}
