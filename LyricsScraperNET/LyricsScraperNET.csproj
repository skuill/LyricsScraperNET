<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net10.0;net9.0;net8.0</TargetFrameworks>
		<LangVersion>latest</LangVersion>
		<Nullable>enable</Nullable>
		<PackageId>LyricsScraperNET</PackageId>
		<Title>LyricsScraperNET</Title>
		<Authors>Vitaly Kvashin</Authors>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageProjectUrl>https://github.com/skuill/LyricsScraperNET/</PackageProjectUrl>
		<PackageRequireLicenseAcceptance>False</PackageRequireLicenseAcceptance>
		<Description>A .NET library that searches song lyrics on several lyrics sites with one API.</Description>
		<PackageTags>lyrics;lyric;song;music;scraper;lrclib;genius;azlyrics;songlyrics;lyricsfreak;kpoplyrics</PackageTags>
		<PackageReadmeFile>PackageReadme.md</PackageReadmeFile>
		<PackageIcon>icon.png</PackageIcon>
		<RepositoryUrl>https://github.com/skuill/LyricsScraperNET</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PublishRepositoryUrl>true</PublishRepositoryUrl>
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<EmbedUntrackedSources>true</EmbedUntrackedSources>
		<NoWarn>1591</NoWarn>
	</PropertyGroup>

	<!-- Deterministic paths for Source Link in CI builds (GitHub Actions sets GITHUB_ACTIONS=true). -->
	<PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
		<ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
	</PropertyGroup>

	<!-- Package Validation: compares the public API with the last release on nuget.org on every pack.
	     Intended breaking changes of a major version are listed in CompatibilitySuppressions.xml (see CLAUDE.md). -->
	<PropertyGroup>
		<EnablePackageValidation>true</EnablePackageValidation>
		<PackageValidationBaselineVersion>3.0.0</PackageValidationBaselineVersion>
		<!-- Builds without a tag: the last release with "-dev", so the assembly version is not lower than the baseline.
		     A release build sets Version from the tag (publish.sh), which overrides both. -->
		<VersionPrefix>$(PackageValidationBaselineVersion)</VersionPrefix>
		<VersionSuffix>dev</VersionSuffix>
	</PropertyGroup>

	<ItemGroup>
		<None Include="PackageReadme.md" Pack="true" PackagePath="\" />
		<!-- Generated by docs/assets/icon/make_icon.py. -->
		<None Include="..\docs\assets\icon\icon-128.png" Pack="true" PackagePath="icon.png" Visible="false" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="HtmlAgilityPack" Version="1.13.1" />
	</ItemGroup>

	<!-- Microsoft.Extensions.* per target framework: the lowest major that matches the framework (latest patch),
	     so an app on .NET 8 does not get 9.x or 10.x packages forced into its dependency graph. -->
	<ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
		<PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="8.0.0" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.2" />
		<PackageReference Include="Microsoft.Extensions.Http" Version="8.0.1" />
		<PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.3" />
		<PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="8.0.0" />
	</ItemGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'net9.0'">
		<PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="9.0.22" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="9.0.22" />
		<PackageReference Include="Microsoft.Extensions.Http" Version="9.0.22" />
		<PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="9.0.22" />
		<PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="9.0.22" />
	</ItemGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
		<PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.14" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.14" />
		<PackageReference Include="Microsoft.Extensions.Http" Version="10.0.14" />
		<PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.14" />
		<PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.14" />
	</ItemGroup>

	<ItemGroup>
		<AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
			<_Parameter1>LyricsScraperNET.UnitTest</_Parameter1>
		</AssemblyAttribute>
		<AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
			<_Parameter1>LyricsScraperNET.IntegrationTest</_Parameter1>
		</AssemblyAttribute>
	</ItemGroup>

</Project>